package utils

public let DEFAULT_LOG_LEVEL = LogLevel.INFO

/**
 * Log print Level
 */
public enum LogLevel {
    | ALL // open log
    | TRACE // track information
    | DEBUG // debug information
    | INFO // notification information
    | WARN // warning message
    | ERROR // error message
    | OFF // disabling logs

    /**
     * Get the log level
     */
    public func level(): Int64 {
        let num = match (this) {
            case ALL => 1
            case TRACE => 2
            case DEBUG => 3
            case INFO => 4
            case WARN => 5
            case ERROR => 6
            case OFF => 7
        }
        return num
    }

    /**
     * Get the log level name
     */
    public func levelName(): String {
        let name = match (this) {
            case ALL => "ALL"
            case TRACE => "TRACE"
            case DEBUG => "DEBUG"
            case INFO => "INFO"
            case WARN => "WARN"
            case ERROR => "ERROR"
            case OFF => "OFF"
        }
        return name
    }

    /**
     * load again >= Operators
     */
    public operator func >=(target: LogLevel): Bool {
        return this.level() >= target.level()
    }

    /**
     * Parse log levels based on character strings.If character strings are not indentified logs of the info level are generated by default.
     *
     * @param lable lable
     *
     * return LogLevel object
     */
    public static func getLevelByString(lable: String): LogLevel {
        let level = match (lable.toAsciiUpper()) {
            case "ALL" => ALL
            case "TRACE" => TRACE
            case "DEBUG" => DEBUG
            case "INFO" => INFO
            case "WARN" => WARN
            case "ERROR" => ERROR
            case "OFF" => OFF
            case _ => DEFAULT_LOG_LEVEL
        }
        return level
    }
}
