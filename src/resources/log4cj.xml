<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender enabled="false" name="console">
        <type>console</type>
        <pattern>[%D %T %m] [%L] [%l] (%S) %M</pattern>
    </appender>
    <appender enabled="true" name="file">
        <type>file</type>
        <pattern>[%D %T %m] [%L] [%l] (%S) %M</pattern>
        <property name="filename">root.log</property>
        <!--
          %T - Time (15:04:05 MST)
          %t - Time (15:04)
          %D - Date (2006/01/02)
          %L - Level (ALL,TRACE,DEBUG,INFO,WARN,ERROR,OFF)
          %S - Source
          %M - Message
        -->
        <property name="rotate">true</property>
        <!--maxsize单位字节-->
        <property name="maxsize">20M</property>
        <property name="daily">false</property>
    </appender>
    <!-- <logger name="Demo">
        <level>info</level>
        <appender-ref ref="console" />
        <appender-ref ref="file" />
    </logger> -->
    <root>
        <level>info</level>
        <appender-ref ref="console" />
        <appender-ref ref="file" />   
    </root>
</configuration>